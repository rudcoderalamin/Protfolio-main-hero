rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Portfolio document: anyone can read; anyone with admin can write
    match /portfolio/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Contact messages: anyone can create; read allowed for admin
    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if true;
    }
  }
}
